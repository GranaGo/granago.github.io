      <Placemark>
        <name>Control de Acceso Pagés</name>
        <description><![CDATA[Pilona de Calle Pagés<br>Pilona situada en la Calle Pagés a la altura de Calle San Gregorio Alto.<br>Desvío alternativo para los vehículos no autorizados por Calle San Gregorio Alto.<br><br><br>Horario:<br>11:00 a 14:00 de Lunes a Domingo<br>20:00 a 00:00 de Domingo a Miércoles y Festivos<br>20:00 a 07:00 de Jueves a Sábado y vísperas de Festivo]]></description>
        <styleUrl>#icon-503-DB4436</styleUrl>
        <Point>
          <coordinates>
            -3.593495,37.183895,0
          </coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Pilona de C/ San Luis</name>
        <description><![CDATA[Pilona de Calle San Luis<br>Pilona situada en Calle San Luis a la altura de Plaza Cruz de Piedra.<br>Los vehículos no autorizados deben retroceder y continuar hacia Fajalauza.<br><br><br>Horario:<br>11:00 a 14:00 de Lunes a Domingo<br>20:00 a 00:00 de Domingo a Miércoles y Festivos<br>20:00 a 07:00 de Jueves a Sábado y vísperas de Festivo]]></description>
        <styleUrl>#icon-503-DB4436</styleUrl>
        <Point>
          <coordinates>
            -3.591703,37.185502,0
          </coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Control de accesos C/Elvira</name>
        <description><![CDATA[Control de accesos de Calle Elvira<br>Control de accesos situado en Calle Elvira a la altura de Calderería Nueva.<br>Desvío para vehículos no autorizados por C/Cárcel Baja<br><br>Horario:<br>7:30 a 24:00 de Lunes a Jueves<br>24 horas de Viernes a Domingo, vísperas de Festivo y Festivos]]></description>
        <styleUrl>#icon-503-DB4436</styleUrl>
        <Point>
          <coordinates>
            -3.597615,37.177663,0
          </coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Control de Accesos de  C/Reyes Católicos</name>
        <description><![CDATA[Control de Accesos de Calle Reyes Católicos.<br>Cámara de captación de matrículas situada en Calle Reyes Católicos a la altura de Calle Sancti Spiritus.<br>Desvío alternativo por la calle Sancti Spiritus para los vehículos no autorizados.<br><br><br>Horario:<br>7:30 a 24:00 de Lunes a Jueves<br>24 horas de Viernes a Domingo, vísperas de Festivo y Festivos]]></description>
        <styleUrl>#icon-503-DB4436</styleUrl>
        <Point>
          <coordinates>
            -3.597035,37.176159,0
          </coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Control Acceso C/Tablas</name>
        <description><![CDATA[Control de Acceso al Centro situado en Calle Tablas.<br><br>Horario:<br><br>Días laborales.<br>Mañana: 8 a 14 h.<br>Tarde: 16 a 20 h.]]></description>
        <styleUrl>#icon-503-DB4436</styleUrl>
        <Point>
          <coordinates>
            -3.6023569,37.1761973,0
          </coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Control de Acceso C/San Matías</name>
        <description><![CDATA[Control de Acceso al barrio del Realejo situado en la Calle San Matías<br><br>Horario:<br><br>Todos los días de 7:30 a 22 horas]]></description>
        <styleUrl>#icon-503-DB4436</styleUrl>
        <Point>
          <coordinates>
            -3.5966707,37.174799,0
          </coordinates>
        </Point>
      </Placemark>
